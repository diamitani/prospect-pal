# Prospect Pal by Salesgency — internal GTM app
# Default production URL
NEXT_PUBLIC_APP_URL=https://prospect.salesgency.com

# --- Supabase: use the existing Enably project (shared with diamitani/enablygtm) ---
# Dashboard → the project named Enably → Settings → API → Project URL
# Public project URL looks like https://<project-ref>.supabase.co
# The ref was not in the enablygtm repo or public deploy HTML (fill in from the dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_ENABLY_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=artifacts
# Sign-up is open (Google, GitHub, email+password). No allowlist.

# --- Worker ---
WORKER_SECRET=change-me-long-random

# --- LLM (optional; free path works without these) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VERCEL_AI_GATEWAY_URL=
DEFAULT_LLM_API_KEY=

# --- BYOK connectors via Composio (optional) ---
COMPOSIO_API_KEY=

# --- n8n (optional export/deploy) ---
N8N_BASE_URL=
N8N_API_KEY=

# --- Stripe (optional; not required for internal app) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
