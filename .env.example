# Prospect Pal by Salesgency — internal GTM app
# Default production URL
NEXT_PUBLIC_APP_URL=https://prospect.salesgency.com

# --- Supabase (required for runs/leads persistence + auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=artifacts

# --- Invite allowlist (fail-closed if both empty) ---
# Comma-separated
ALLOWLIST_EMAILS=you@salesgency.com
ALLOWLIST_DOMAINS=salesgency.com
# Local demo only — never set true in production
ALLOWLIST_OPEN=false

# --- Worker ---
WORKER_SECRET=change-me-long-random

# --- LLM (optional; free path works without these) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VERCEL_AI_GATEWAY_URL=
DEFAULT_LLM_API_KEY=

# --- BYOK connectors via Composio (optional) ---
COMPOSIO_API_KEY=

# --- n8n (optional export/deploy) ---
N8N_BASE_URL=
N8N_API_KEY=

# --- Stripe (optional; not required for internal app) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
