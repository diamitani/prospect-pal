          }
        ]
      ]
    },
    "05: Contact Reveal": {
      "main": [
        [
          {
            "node": "06: Deliverability Pre-Flight",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "06: Deliverability Pre-Flight": {
      "main": [
        [
          {
            "node": "07: Pre-Flight Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "07: Pre-Flight Gate": {
      "main": [
        [
          {
            "node": "08: AI PAS Draft (review required)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "08: AI PAS Draft (review required)": {
      "main": [
        [
          {
