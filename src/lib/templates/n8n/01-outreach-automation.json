{
  "name": "SalesGency \u2014 01 Outreach Automation (Signal \u2192 Draft \u2192 Approve)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sg-outreach-intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "outreach-trigger",
      "name": "01: Trigger Ingest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json.body || $input.first().json;\nreturn [{\n  json: {\n    company_domain: (item.domain || item.email?.split('@')[1] || '').toLowerCase().trim(),\n    company_name: item.company || '',\n    contact_name: item.name || '',\n    contact_email: (item.email || '').toLowerCase().trim(),\n    target_titles: item.target_titles || ['VP Sales', 'Head of Revenue', 'Founder', 'CRO'],\n    trigger_type: item.company ? 'company_automation' : 'contact_automation'\n  }\n}];"
      },
      "id": "outreach-normalize",
      "name": "02: Normalize & Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.hubapi.com/crm/v3/objects/companies/search",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.HUBSPOT_ACCESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"filterGroups\": [{\n    \"filters\": [{\n      \"propertyName\": \"domain\",\n      \"operator\": \"EQ\",\n      \"value\": \"{{ $json.company_domain }}\"\n    }]\n  }]\n}",
        "options": {}
      },
      "id": "outreach-dedupe",
      "name": "03: CRM Dedupe Shield",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.total }}",
              "operation": "equal",
              "value2": 0
            }
          ]
        }
      },
      "id": "outreach-gate",
      "name": "04: Collision Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.apollo.io/v1/mixed_people/search",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"api_key\": \"{{ $env.APOLLO_API_KEY }}\",\n  \"q_organization_domains\": \"{{ $('02: Normalize & Contract').item.json.company_domain }}\",\n  \"person_titles\": {{ JSON.stringify($('02: Normalize & Contract').item.json.target_titles) }},\n  \"page\": 1,\n  \"per_page\": 1\n}",
        "options": {}
      },
      "id": "outreach-reveal",
      "name": "05: Contact Reveal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const person = $input.first().json.people?.[0] || {};\nconst email = person.email || $('02: Normalize & Contract').item.json.contact_email || '';\nconst emailOk = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/.test(email);\nconst roleLike = /^(info|support|sales|admin|contact|help)@/i.test(email);\nconst verdict = (emailOk && !roleLike && email) ? 'pass' : 'skip';\nreturn [{ json: { ...$input.first().json,\n  preflight_email: email, email_format_ok: emailOk, is_role_address: roleLike,\n  preflight: verdict, reveal_name: person.name || '' } }];"
      },
      "id": "outreach-preflight",
      "name": "06: Deliverability Pre-Flight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.preflight }}",
              "operation": "equals",
              "value2": "pass"
            }
          ]
        }
      },
      "id": "outreach-preflight-gate",
      "name": "07: Pre-Flight Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1500,
        200
      ]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-latest",
        "prompt": "=Write a 3-sentence Problem-Agitate-Solve cold email to {{ $json.reveal_name || 'there' }} at {{ $('02: Normalize & Contract').item.json.company_name }}.\n\nRules:\n- Under 65 words.\n- Sentence 1: specific pain trigger (speed to lead or SDR capacity).\n- Sentence 2: financial impact / deal leakage.\n- Sentence 3: low-friction interest-based ask.\nOutput ONLY the email body, no preamble.",
        "options": {}
      },
      "id": "outreach-draft",
      "name": "08: AI PAS Draft (review required)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        1720,
        100
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SLACK_ALERTS_WEBHOOK }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \":email: *Outreach draft ready for approval*\\n*To:* {{ $json.reveal_name }} ({{ $json.preflight_email }})\\n*Company:* {{ $('02: Normalize & Contract').item.json.company_name }}\\n*Pre-flight:* {{ $json.preflight }}\\n\\n*Draft:*\\n{{ $json.output }}\"\n}",
        "options": {}
      },
      "id": "outreach-approve",
      "name": "09: Slack Approval Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1940,
        300
      ]
    }
  ],
  "connections": {
    "01: Trigger Ingest": {
      "main": [
        [
          {
            "node": "02: Normalize & Contract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "02: Normalize & Contract": {
      "main": [
        [
          {
