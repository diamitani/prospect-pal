{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/app/**",
              "components/brand/**",
              "components/core/**",
              "components/marketing/**",
              "components/pipeline/**",
              "ui_kits/app/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono|Instrument Serif))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono, Instrument Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|mono|shape|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, mono, shape, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|premium|verified|attention|blocked|deep)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'premium' | 'verified' | 'attention' | 'blocked' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|square)$/]",
        "message": "<Badge> shape must be one of 'pill' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|disabled|fullWidth|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, disabled, fullWidth, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|outline|ghost|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'outline' | 'ghost' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|pad|interactive|radius|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, pad, interactive, radius, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|sunken|deep|accent)$/]",
        "message": "<Card> tone must be one of 'paper' | 'sunken' | 'deep' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: role, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:user|assistant)$/]",
        "message": "<ChatBubble> role must be one of 'user' | 'assistant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeliverableCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:file|label|description|badge|key|ref|className|style|children)$/]",
        "message": "<DeliverableCard> doesn't accept that prop. Declared props: file, label, description, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|ghost|deep)$/]",
        "message": "<IconButton> variant must be one of 'outline' | 'ghost' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|type|icon|mono|disabled|invalid|fullWidth|onSubmitKey|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, type, icon, mono, disabled, invalid, fullWidth, onSubmitKey, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password|url)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'password' | 'url'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntegrationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|icon|capability|connected|key|ref|className|style|children)$/]",
        "message": "<IntegrationCard> doesn't accept that prop. Declared props: name, description, icon, capability, connected."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|htmlFor|step|hint|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children, htmlFor, step, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeadSignalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:company|round|stack|trigger|contact|verified|key|ref|className|style|children)$/]",
        "message": "<LeadSignalCard> doesn't accept that prop. Declared props: company, round, stack, trigger, contact, verified."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|onDeep|tagline|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, onDeep, tagline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|mark)$/]",
        "message": "<Logo> variant must be one of 'lockup' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|eyebrow|onClose|footer|width|tone|children|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, eyebrow, onClose, footer, width, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|deep)$/]",
        "message": "<Modal> tone must be one of 'paper' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|active|onClick|badge|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, icon, active, onClick, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|title|subtitle|icon|stage|binding|selected|onDeep|onClick|style|key|ref|className|style|children)$/]",
        "message": "<NodeCard> doesn't accept that prop. Declared props: step, title, subtitle, icon, stage, binding, selected, onDeep, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeCard'] > JSXAttribute[name.name='stage'] > Literal[value!=/^(?:trigger|shield|data|ai|sequence|logic)$/]",
        "message": "<NodeCard> stage must be one of 'trigger' | 'shield' | 'data' | 'ai' | 'sequence' | 'logic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PipelineRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:nodes|activeIndex|onSelect|onDeep|style|key|ref|className|style|children)$/]",
        "message": "<PipelineRail> doesn't accept that prop. Declared props: nodes, activeIndex, onSelect, onDeep, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|cadence|note|description|features|cta|featured|tone|key|ref|className|style|children)$/]",
        "message": "<PricingCard> doesn't accept that prop. Declared props: name, price, cadence, note, description, features, cta, featured, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|sunken)$/]",
        "message": "<PricingCard> tone must be one of 'paper' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|align|onDeep|action|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, description, align, onDeep, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHeading> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|tone|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: value, unit, label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|brand|verified|premium)$/]",
        "message": "<StatTile> tone must be one of 'ink' | 'brand' | 'verified' | 'premium'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|pulse|onDeep|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: label, tone, pulse, onDeep, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:verified|attention|blocked|brand)$/]",
        "message": "<StatusPill> tone must be one of 'verified' | 'attention' | 'blocked' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|onStep|key|ref|className|style|children)$/]",
        "message": "<StepIndicator> doesn't accept that prop. Declared props: steps, current, onStep."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|rows|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: value, onChange, placeholder, rows, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolOptionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|caption|meta|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<ToolOptionCard> doesn't accept that prop. Declared props: icon, title, caption, meta, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypingDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<TypingDots> doesn't accept that prop. Declared props: label."
      }
    ]
